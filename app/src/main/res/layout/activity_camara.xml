<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_camara">

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/cuandro_enfoque"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:background="#3E09EDDA"
        android:src="@android:drawable/ic_menu_mylocation" />

    <ImageButton
        android:id="@+id/boton_aceptar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="false"
        android:layout_alignParentEnd="false"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:background="#00FFFFFF"
        android:onClick="resultado"
        android:scaleX="0.5"
        android:scaleY="0.5"
        app:srcCompat="@drawable/solicit_accept_check_ok_theaction_6340__1_" />

    <ImageButton
        android:id="@+id/boton_rechazar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="false"
        android:layout_alignParentBottom="true"
        android:background="#00FFFFFF"
        android:onClick="regresar_menu"
        android:scaleX="0.5"
        android:scaleY="0.5"
        app:srcCompat="@drawable/cancellationbutton_exitneartheaction_botondecancelacion_salida_6335" />

    <ImageButton
        android:id="@+id/flipCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/toggleFlash"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="false"
        android:background="#00FFFFFF"
        android:scaleX=".9"
        android:scaleY=".9"
        android:src="@drawable/camera_reverse_icon_235167"
        app:tint="#fff" />

    <ImageButton
        android:id="@+id/capture"
        android:layout_width="60sp"
        android:layout_height="60sp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40sp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerCrop"
        android:src="@drawable/_36shutter_99926"
        app:tint="#fff" />

    <ImageButton
        android:id="@+id/toggleFlash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="#00FFFFFF"
        android:scaleX=".8"
        android:scaleY=".8"
        android:src="@drawable/baseline_flash_on_24"
        app:tint="#fff" />

</RelativeLayout>

