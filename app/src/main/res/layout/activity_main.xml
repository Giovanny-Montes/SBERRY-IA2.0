<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/editTextText2"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:clickable="false"
        android:contextClickable="false"
        android:defaultFocusHighlightEnabled="false"
        android:ems="10"
        android:text="Powered by TensorFlow"
        android:textColor="#000000"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText,SmallSp" />


    <LinearLayout
        android:id="@+id/linearLayout7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8A596AC1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/linearLayout6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:id="@+id/linearLayout5"
                android:layout_width="match_parent"
                android:layout_height="279dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="251dp"
                    android:layout_height="216dp"
                    android:layout_gravity="center_horizontal"
                    app:srcCompat="@drawable/logo_sin_fondo"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:fontFamily="monospace"
                    android:text="SBerry-I.A. 2.0"
                    android:textAlignment="center"
                    android:textColor="#FFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:gravity="center_horizontal"
                android:padding="8dp"
                app:layout_constraintBottom_toTopOf="@+id/imageView"
                tools:layout_editor_absoluteX="16dp">

                <Button
                    android:id="@+id/boton_salir"
                    android:layout_width="118dp"
                    android:layout_height="57dp"
                    android:layout_margin="16dp"
                    android:onClick="salir"
                    android:text="Salir"
                    tools:ignore="ButtonStyle,HardcodedText" />

                <Button
                    android:id="@+id/boton_entrar"
                    android:layout_width="118dp"
                    android:layout_height="57dp"
                    android:layout_margin="16dp"
                    android:onClick="entrar"
                    android:text="Entrar"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
            //

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#758C8688"
                android:orientation="vertical"
                android:padding="16dp"
                android:textColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:onClick="opciones_usuario"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ico_opciones_usuario"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/contacts_profile_account_connection_icon_124666" />

                    <TextView
                        android:id="@+id/id_opciones_usuario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Usuario"
                        android:textColor="#FFFFFF"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:onClick="manual_usuario"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:textColor="#FFFFFF">

                    <ImageView
                        android:id="@+id/ico_manual_usuario"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/help_43559" />

                    <TextView
                        android:id="@+id/id_manual_usuario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Manual"
                        android:textColor="#FFFFFF"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:onClick="contribuciones"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ico_contribuciones"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/person_account_file_folder_document_icon_124634" />

                    <TextView
                        android:id="@+id/id_contribuciones"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Contribuciones"
                        android:textColor="#FFFFFF"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:onClick="alerta_temprana"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ico_alerta_temprana"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/add_new_create_map_location_icon_124696" />

                    <TextView
                        android:id="@+id/id_alerta_temprana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Sistema de Alerta Temprana"
                        android:textColor="#FFFFFF"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>