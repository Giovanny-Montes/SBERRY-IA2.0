<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity_eleccion">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/boton_salir2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="salir"
            android:text="Atras"
            android:textColorLink="#BBDEFB"
            tools:ignore="ButtonStyle,HardcodedText,OnClick" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        tools:context=".MainActivity"
        tools:layout_editor_absoluteX="-90dp"
        tools:layout_editor_absoluteY="0dp">

        <LinearLayout
            android:layout_width="365dp"
            android:layout_height="394dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/boton_camara"
                android:layout_width="167dp"
                android:layout_height="149dp"
                android:backgroundTint="#00FFFFFF"
                android:onClick="eleccion_camara"
                android:scaleX="1"
                android:scaleY="1"
                app:srcCompat="@drawable/images_canon_camera_1745" />

            <TextView
                android:id="@+id/texto_camara"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="Imagen desde Cámara" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="379dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/boton_archivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#00FFFFFF"
                android:onClick="eleccion_galleria"
                android:scaleX="0.8"
                android:scaleY="0.8"
                app:srcCompat="@drawable/view_search_find_image_photo_6099" />

            <TextView
                android:id="@+id/texto_galleria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="Imagen desde Archivo" />

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>